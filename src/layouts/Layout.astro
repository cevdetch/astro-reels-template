---
import '../styles/base.css';
import { siteConfig } from '../config.ts';
import { SITE_NAME, resolveSeo, type LayoutProps } from '../lib/seo.ts';
import { isoDate } from '../lib/text.ts';

type Props = LayoutProps;

const seo = await resolveSeo(Astro.props, {
  site: Astro.site,
  pathname: Astro.url.pathname,
  mode: import.meta.env.DEV ? 'dev' : Astro.isPrerendered ? 'build' : 'server',
  socialImages: siteConfig.socialImages,
});
const { ogType = 'website', publishedTime, modifiedTime } = Astro.props;
// A "<" in the data must not end the script element early.
const jsonLd = Astro.props.jsonLd?.replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head data-starter-social-v1={seo.generatedImageUrl}>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {seo.canonicalUrl && <link rel="canonical" href={seo.canonicalUrl} />}
    <meta name="description" content={seo.description} />
    {seo.robots && <meta name="robots" content={seo.robots} />}
    {seo.social && (
      <>
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={seo.social.url} />
        <meta property="og:title" content={seo.ogTitle} />
        <meta property="og:description" content={seo.description} />
        <meta property="og:image" content={seo.social.imageUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        {ogType === 'article' && publishedTime && <meta property="article:published_time" content={isoDate(publishedTime)} />}
        {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={isoDate(modifiedTime)} />}
      </>
    )}
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
  </head>
  <body class={Astro.props.bodyClass}>
    <header class="site">
      <nav aria-label="Primary"><a href="/">{SITE_NAME}</a></nav>
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
