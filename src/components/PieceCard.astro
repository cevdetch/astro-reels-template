---
import { siteConfig } from '../config.ts';
import type { Piece } from '../lib/collection.ts';
import { feedHref, pageOf } from '../lib/feed.ts';
import { pieceWords, piecePath } from '../lib/pieces.ts';
import { stanzas } from '../lib/verse.ts';

interface Props { piece: Piece; total: number; level?: 'h1' | 'h2'; context: 'feed' | 'page' }
const { piece, total, level = 'h2', context } = Astro.props;
const n = piece.data.number;
const verse = stanzas(piece.body ?? '');
const Heading = level;
const { label, creator } = siteConfig.pieces;
const words = pieceWords();
// The next piece: on this page by its anchor, on the next page by its place there.
const next = n < total ? (pageOf(n + 1) === pageOf(n) ? `#${n + 1}` : feedHref(n + 1)) : undefined;
---

<section class="card piece" id={context === 'feed' ? String(n) : undefined} aria-labelledby={`piece-${n}`}>
  <div class="poem">
    {context === 'feed' && <Heading class="number" id={`piece-${n}`}><span class="visually-hidden">{label} </span>{n} of {total}</Heading>}
    {context === 'page' && (
      <>
        <Heading class="number" id={`piece-${n}`}>{words.piece(n)}</Heading>
        <p class="byline">{creator}</p>
      </>
    )}
    <div class="verse">
      {verse.map((stanza) => (
        <p>{stanza.map((line) => <span class:list={['line', { indent: line.indent }]}>{line.text}</span>)}</p>
      ))}
    </div>
    {context === 'feed' && (
      <nav class="card-links" aria-label={words.piece(n)}>
        {next && <a href={next}>Next<span class="visually-hidden">{`: ${words.piece(n + 1)}`}</span> ↓</a>}
        {!next && <a href={feedHref(1)}>Back to the first ↑</a>}
        <a href={piecePath(n)}><span class="visually-hidden">{`${words.pieceOwner(n)} `}</span>Own page →</a>
      </nav>
    )}
    {context === 'page' && (
      <nav class="card-links" aria-label={words.more}>
        {n > 1 && <a href={piecePath(n - 1)} rel="prev">{`← ${words.piece(n - 1)}`}</a>}
        {n < total && <a href={piecePath(n + 1)} rel="next">{`${words.piece(n + 1)} →`}</a>}
        <a href={feedHref(n)}>See it in the feed</a>
      </nav>
    )}
  </div>
</section>
