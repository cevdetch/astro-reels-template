---
import Intro from './Intro.astro';
import PieceCard from './PieceCard.astro';
import type { Piece } from '../lib/collection.ts';
import { feedHref, pageCount, pageRange, PAGE_SIZE } from '../lib/feed.ts';
import { pieceWords, sharedCreator } from '../lib/pieces.ts';
import { PIECES_PATH } from '../lib/seo.ts';
import '../styles/feed.css';

interface Props { page: number; pieces: Piece[] }
const { page, pieces } = Astro.props;
const total = pieces.length;
const pages = pageCount(total);
const { first, last } = pageRange(page, total);
const shown = pieces.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const before = page > 1 ? pageRange(page - 1, total) : undefined;
const after = page < pages ? pageRange(page + 1, total) : undefined;
const words = pieceWords();
---

<div class="feed">
  {page === 1 && <Intro />}
  {page > 1 && before && (
    <section class="card previous" aria-label={words.previousGroup}>
      <h1 class="number">{words.range(first, last)}</h1>
      <a href={feedHref(before.last)} rel="prev">{`← Previous: ${words.range(before.first, before.last)}`}</a>
    </section>
  )}
  {shown.map((piece) => <PieceCard piece={piece} total={total} context="feed" />)}
  {after && (
    <section class="card next" aria-label={words.nextGroup}>
      <a href={feedHref(after.first)} rel="next">{`Next: ${words.range(after.first, after.last)} →`}</a>
    </section>
  )}
  {!after && (
    <section class="card end" aria-labelledby="the-end">
      <div class="poem">
        <h2 class="number" id="the-end">The end</h2>
        <p class="closing">{words.closing(total, sharedCreator(pieces.map((piece) => piece.data)))}</p>
        <nav class="card-links" aria-label="After the last"><a href={PIECES_PATH}>Contents →</a><a href={feedHref(1)}>Start again ↑</a></nav>
      </div>
    </section>
  )}
</div>
